# ── Anthropic (Orchestrator + Storyline Agent) ──────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key

# ── Video Generation APIs (pick one or more) ────────────────────────────────
RUNWAYML_API_KEY=your_runwayml_api_key
PIKA_API_KEY=your_pika_api_key
LUMAAI_API_KEY=your_lumaai_api_key

# ── Speech-to-Text / Subtitle ───────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key          # Whisper transcription
DEEPL_API_KEY=your_deepl_api_key            # Translation

# ── YouTube ─────────────────────────────────────────────────────────────────
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token

# ── TikTok ──────────────────────────────────────────────────────────────────
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token

# ── Instagram / Facebook ────────────────────────────────────────────────────
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token
FACEBOOK_PAGE_ID=your_facebook_page_id

# ── Twitter / X ─────────────────────────────────────────────────────────────
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret

# ── System Config ────────────────────────────────────────────────────────────
OUTPUT_DIR=outputs
LOG_LEVEL=INFO
VIDEO_PROVIDER=runwayml         # runwayml | pika | lumaai | mock
SUBTITLE_LANGUAGES=en,es,fr,de,ja,zh,ko,pt,ar,hi
